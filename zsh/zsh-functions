# Function to source files if they exist
function zsh_add_file() {
	[ -f "$ZDOTDIR/$1" ] && source "$ZDOTDIR/$1"
}

function zsh_add_plugin() {
	PLUGIN_NAME=$(echo $1 | cut -d "/" -f 2)
	if [ -d "$ZDOTDIR/plugins/$PLUGIN_NAME" ]; then
		# For plugins
		zsh_add_file "plugins/$PLUGIN_NAME/$PLUGIN_NAME.plugin.zsh" || \
		zsh_add_file "plugins/$PLUGIN_NAME/$PLUGIN_NAME.zsh"
	else
		git clone "https://github.com/$1.git" "$ZDOTDIR/plugins/$PLUGIN_NAME"
	fi
}

function zsh_add_completion() {
	PLUGIN_NAME=$(echo $1 | cut -d "/" -f 2)
	if [ -d "$ZDOTDIR/plugins/$PLUGIN_NAME" ]; then
		# For completions
		completion_file_path=$(ls $ZDOTDIR/plugins/$PLUGIN_NAME/_*)
		fpath+="$(dirname "${completion_file_path}")"
		zsh_add_file "plugins/$PLUGIN_NAME/$PLUGIN_NAME.plugin.zsh"
	else
		git clone "https://github.com/$1.git" "$ZDOTDIR/plugins/$PLUGIN_NAME"
		fpath+=$(ls $ZDOTDIR/plugins/$PLUGIN_NAME/_*)
		[ -f $ZDOTDIR/.zccompdump ] && $ZDOTDIR/.zccompdump
	fi
	completion_file="$(basename "${completion_file_path}")"
	if [ "$2" = true ] && compinit "${completion_file:1}"
}

# Use lf to switch directories and bind it to ctrl-o
function lfcd () {
	tmp="$(mktemp)"
	lf -last-dir-path="$tmp" "$@"
	if [ -f "$tmp" ]; then
		dir="$(cat "$tmp")"
		rm -f "$tmp" >/dev/null
		[ -d "$dir" ] && [ "$dir" != "$(pwd)" ] && cd "$dir"
	fi
}

function fzf-ps () {
  (date; ps -ef) |
	fzf --bind='ctrl-r:reload(date; ps -ef)' \
		--header=$'Press CTRL-R to reload\n\n' --header-lines=2 \
		--preview='echo {}' --preview-window=down,3,wrap \
		--layout=reverse --height=80% | awk '{print $2}' | xargs kill -9
}

# Universal package search with fzf
function pkgsearch() {
	local pkg_manager=$1
	local log_enabled=true
	local log_file=~/pkgsearch.log
	local log_max_size=1048576 # 1 MB in bytes
	local packages

	# Validate the input package manager
	if [ -n "$pkg_manager" ]; then
		case "$pkg_manager" in
			pacman|yay|paru|apt|dnf|zypper|brew)
				;; # Valid package manager
			*)
				echo "Invalid package manager specified: $pkg_manager" >&2
				return 1
				;;
		esac
	fi
	
	# Detect package manager if not passed as an argument
	if [ -z "$pkg_manager" ]; then
		if command -v pacman &>/dev/null; then
			pkg_manager="pacman"
		elif command -v yay &>/dev/null; then
			pkg_manager="yay"
		elif command -v paru &>/dev/null; then
			pkg_manager="paru"
		elif command -v apt &>/dev/null; then
			pkg_manager="apt"
		elif command -v dnf &>/dev/null; then
			pkg_manager="dnf"
		elif command -v zypper &>/dev/null; then
			pkg_manager="zypper"
		elif command -v brew &>/dev/null; then
			pkg_manager="brew"
		else
			echo "Supported package manager not found (pacman, yay, paru, apt, dnf, zypper, brew)." >&2
			return 1
		fi
	fi

	# Perform fuzzy search and preview based on the package manager
	case "$pkg_manager" in
		pacman|yay|paru)
			packages=$($pkg_manager -Slq | fzf --multi --preview "$pkg_manager -Si {1}")
			;;
		apt)
			packages=$(apt-cache pkgnames | fzf --multi --preview 'apt show {1}')
			;;
		dnf)
			packages=$(dnf list available --quiet | awk '{print $1}' | fzf --multi --preview 'dnf info {1}')
			;;
		zypper)
			packages=$(zypper search --type package | awk 'NR>2 {print $3}' | fzf --multi --preview 'zypper info {1}')
			;;
		brew)
			packages=$((
				HOMEBREW_NO_AUTO_UPDATE=1 brew formulae | awk '{print "formula\t" $0}'
				HOMEBREW_NO_AUTO_UPDATE=1 brew casks | awk '{print "cask\t" $0}'
			) | fzf --multi --delimiter=$'\t' --with-nth=2 \
				--preview='if [ "{1}" = "cask" ]; then HOMEBREW_NO_AUTO_UPDATE=1 brew info --cask {2}; else HOMEBREW_NO_AUTO_UPDATE=1 brew info {2}; fi')
			;;
		*)
			echo "Unsupported package manager: $pkg_manager" >&2
			return 1
			;;
	esac

	# Install selected packages
	if [ -n "$packages" ]; then
		local install_status=0
		local -a install_cmd
		case "$pkg_manager" in
			pacman)
				install_cmd=(sudo "$pkg_manager" -S ${(f)packages})
				;;
			yay|paru)
				install_cmd=("$pkg_manager" -S ${(f)packages})
				;;
			apt)
				install_cmd=(sudo apt install ${(f)packages})
				;;
			dnf)
				install_cmd=(sudo dnf install ${(f)packages})
				;;
			zypper)
				install_cmd=(sudo zypper install ${(f)packages})
				;;
			brew)
				while IFS=$'\t' read -r pkg_type pkg_name; do
					[ -z "$pkg_name" ] && continue
					if [ "$pkg_type" = "cask" ]; then
						echo "HOMEBREW_NO_AUTO_UPDATE=1 brew install --cask $pkg_name"
						HOMEBREW_NO_AUTO_UPDATE=1 brew install --cask "$pkg_name" || install_status=1
					else
						echo "HOMEBREW_NO_AUTO_UPDATE=1 brew install $pkg_name"
						HOMEBREW_NO_AUTO_UPDATE=1 brew install "$pkg_name" || install_status=1
					fi
					[ "$install_status" -ne 0 ] && break
					done <<< "$packages"
				;;
		esac

		if [ "$pkg_manager" != "brew" ]; then
			print -r -- "${(q)install_cmd}"
			"${install_cmd[@]}"
			install_status=$?
		fi

		if [ "$install_status" -eq 0 ]; then
			if [ "$log_enabled" = true ]; then
				if [ -f "$log_file" ] && [ "$(wc -c < "$log_file")" -gt "$log_max_size" ]; then
					mv "$log_file" "${log_file}.old"
				fi
				if [ "$pkg_manager" = "brew" ]; then
					echo "$packages" | awk -F '\t' -v now="$(date)" '{print "[" now "]: brew " $1 " " $2}' >> "$log_file"
				else
					echo "[$(date)]: $packages" >> "$log_file"
				fi
			fi
		fi
	else
		echo "No packages selected."
	fi
}


# Yazi File-Manager
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}

sftp_transfer() {
	# Check if the number of arguments is correct
    if [ "$#" -ne 2 ]; then
        echo "Usage: sftp_transfer <sftp_host> <file_list>"
        return 1
    fi

    local SFTP_HOST="$1"
    local FILE_LIST="$2"
    local SFTP_USER="root"
    local SFTP_PASS="xirtam"

    if [[ ! -f "$FILE_LIST" ]]; then
        echo "File list '$FILE_LIST' does not exist."
        return 1
    fi

    # Check if sshpass is installed
    if ! command -v sshpass &> /dev/null; then
        echo "Error: sshpass is not installed. Please install it and try again."
        return 1
    fi

    # Execute the SFTP transfer
    sshpass -p "$SFTP_PASS" sftp $SFTP_USER@$SFTP_HOST <<EOF
$(while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    SRC_PATH=$(echo $line | awk '{print $1}')
    DEST_PATH=$(echo $line | awk '{print $2}')
    echo "put $SRC_PATH $DEST_PATH"
done < "$FILE_LIST")
EOF

    # Check the exit status of the SFTP command
    if [ $? -ne 0 ]; then
        echo "Error: SFTP transfer failed."
        return 1
    fi

    echo "SFTP transfer completed successfully."

}

